{
  "actorSpecification": 1,
  "name": "employment-hero-scraper",
  "title": "Employment Hero Jobs Scraper — Australia Careers",
  "description": "Extract job listings from Employment Hero's Australian job board. Returns job title, company, location, salary, job type, and full descriptions. Built for recruiters, job seekers, and market researchers. Works with Claude, ChatGPT, and AI agents via Apify MCP integration.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Employment Hero Job Listings",
      "description": "Scraped job data from Employment Hero Australia",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "jobTitle",
              "company",
              "location",
              "salary",
              "jobType",
              "url"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "jobTitle": {
                "label": "Job Title",
                "format": "text"
              },
              "company": {
                "label": "Company",
                "format": "text"
              },
              "location": {
                "label": "Location",
                "format": "text"
              },
              "salary": {
                "label": "Salary",
                "format": "text"
              },
              "jobType": {
                "label": "Type",
                "format": "text"
              },
              "url": {
                "label": "URL",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "jobTitle": {
          "type": "string",
          "title": "Job Title",
          "description": "Position title"
        },
        "company": {
          "type": "string",
          "title": "Company",
          "description": "Hiring organization name"
        },
        "location": {
          "type": "string",
          "title": "Location",
          "description": "Job location (city, state, postcode)"
        },
        "salary": {
          "type": "string",
          "title": "Salary",
          "description": "Salary range or compensation details"
        },
        "jobType": {
          "type": "string",
          "title": "Job Type",
          "description": "Employment type (FULL_TIME, PART_TIME, CASUAL, etc.)"
        },
        "description": {
          "type": "string",
          "title": "Description",
          "description": "Full job description text"
        },
        "url": {
          "type": "string",
          "title": "URL",
          "description": "Direct link to job posting",
          "format": "url"
        },
        "scrapedAt": {
          "type": "string",
          "title": "Scraped At",
          "description": "ISO timestamp of data extraction",
          "format": "date-time"
        }
      }
    }
  }
}
