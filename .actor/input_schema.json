{
  "title": "Employment Hero Scraper Input",
  "schemaVersion": 1,
  "properties": {
    "searchQuery": {
      "type": "string",
      "title": "Search Query",
      "description": "Job title or keyword to search for",
      "prefill": "software engineer",
      "editor": "textfield"
    },
    "location": {
      "type": "string",
      "title": "Location",
      "description": "City or state to filter jobs",
      "prefill": "Sydney",
      "editor": "textfield"
    },
    "maxResults": {
      "type": "integer",
      "title": "Max Results",
      "description": "Maximum number of jobs to scrape",
      "default": 50,
      "prefill": 10,
      "minimum": 1,
      "maximum": 500
    },
    "proxyConfiguration": {
      "type": "object",
      "title": "Proxy Configuration",
      "description": "Apify proxy settings",
      "prefill": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"]
      },
      "editor": "proxy"
    }
  },
  "required": ["maxResults"]
}
